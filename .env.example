# Copy to .env.local and fill in. Never commit real keys.

# Public URL of the deployed site: canonical URLs, sitemap, Open Graph, JSON-LD.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=

# ── Contact form (https://resend.com) ─────────────────────────
# Without RESEND_API_KEY, dev logs messages to the console and production returns 503.
RESEND_API_KEY=
# Inbox that receives messages (defaults to site.email in src/content/site.ts).
CONTACT_TO_EMAIL=
# Must be a sender on a domain you've verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.dev>"

# ── GitHub contribution graph ─────────────────────────────────
# Defaults to site.githubUsername (ZeonArc). If the data can't be fetched, the graph is hidden.
GITHUB_USERNAME=
# Optional: raises the GitHub API rate limit (no scopes needed).
GITHUB_TOKEN=
